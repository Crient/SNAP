{
  "name": "snap",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "compress-images": "node scripts/compress-images.js",
    "build:cloudflare": "npm run build && node cloudflare/prepare.mjs",
